{ system
  , compiler
  , flags
  , pkgs
  , hsPkgs
  , pkgconfPkgs
  , errorHandler
  , config
  , ... }:
  {
    flags = {
      abi-assertions = true;
      abi-assertions-exact = false;
      optimize = true;
      optimize-aggressively = false;
      strict = false;
      strict-data = true;
    };
    package = {
      specVersion = "2.2";
      identifier = { name = "mpv-bindgen-sys"; version = "0.0.0.1"; };
      license = "BSD-3-Clause";
      copyright = "(c) 2026 Jeremy Nuttall";
      maintainer = "jeremy@jeremy-nuttall.com";
      author = "Jeremy Nuttall";
      homepage = "https://github.com/jtnuttall/lithon#readme";
      url = "";
      synopsis = "Complete libmpv bindings, raw + curated, generated by hs-bindgen";
      description = "Machine-generated low-level bindings to the whole libmpv client API\n(client, render, OpenGL render, and stream callback headers): the raw\nhs-bindgen output (@Mpv.Sys.Bindgen.*@) plus a curated @Mpv.Sys@ layer\nwith per-function safe/unsafe FFI decisions and native Haskell scalars.\nlibmpv's own header documentation rides along in the haddocks.\n\nA generated translation unit of C @_Static_assert@s checks the baked\nlayouts against your installed libmpv at every build, so ABI divergence\nis a compile error rather than memory corruption.\n\nSupports 64-bit Linux, macOS, and Windows, with libmpv client API >= 2.0\ndevelopment headers present. See the README for a quick start, the\nlicensing note (libmpv itself is GPLv2+ by default), and the list of\ndeliberate omissions.";
      buildType = "Simple";
    };
    components = {
      "library" = {
        depends = [
          (hsPkgs."base" or (errorHandler.buildDepError "base"))
          (hsPkgs."mpv-bindgen-sys".components.sublibs.bindgen-runtime or (errorHandler.buildDepError "mpv-bindgen-sys:bindgen-runtime"))
          (hsPkgs."mpv-bindgen-sys".components.sublibs.cexpr-runtime or (errorHandler.buildDepError "mpv-bindgen-sys:cexpr-runtime"))
        ];
        pkgconfig = [
          (pkgconfPkgs."mpv" or (errorHandler.pkgConfDepError "mpv"))
        ];
        buildable = true;
      };
      sublibs = {
        "bindgen-runtime" = {
          depends = [
            (hsPkgs."base" or (errorHandler.buildDepError "base"))
            (hsPkgs."bytestring" or (errorHandler.buildDepError "bytestring"))
            (hsPkgs."containers" or (errorHandler.buildDepError "containers"))
            (hsPkgs."primitive" or (errorHandler.buildDepError "primitive"))
            (hsPkgs."record-hasfield" or (errorHandler.buildDepError "record-hasfield"))
            (hsPkgs."template-haskell" or (errorHandler.buildDepError "template-haskell"))
            (hsPkgs."vector" or (errorHandler.buildDepError "vector"))
          ];
          build-tools = [
            (hsPkgs.pkgsBuildBuild.hsc2hs.components.exes.hsc2hs or (pkgs.pkgsBuildBuild.hsc2hs or (errorHandler.buildToolDepError "hsc2hs:hsc2hs")))
          ];
          buildable = true;
        };
        "cexpr-runtime" = {
          depends = [
            (hsPkgs."base" or (errorHandler.buildDepError "base"))
            (hsPkgs."containers" or (errorHandler.buildDepError "containers"))
            (hsPkgs."fin" or (errorHandler.buildDepError "fin"))
            (hsPkgs."some" or (errorHandler.buildDepError "some"))
            (hsPkgs."template-haskell" or (errorHandler.buildDepError "template-haskell"))
            (hsPkgs."vec" or (errorHandler.buildDepError "vec"))
          ];
          buildable = true;
        };
      };
    };
  }